+        reason = item.get("reason")
+        if state == "blocked" and reason not in BLOCKED_REASONS:
+            problems.append(f"module {key!r} is blocked with reason {reason!r}; allowed {list(BLOCKED_REASONS)}")
+        if state != "blocked" and "reason" in item:
