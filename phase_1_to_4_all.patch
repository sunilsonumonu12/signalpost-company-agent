+    if not path:
+        return {}
+    p = Path(path)
+    if not p.exists():
+        print(f"Warning: --previous-envelopes file {p} does not exist", file=sys.stderr)
+        return {}
+
+    bad_lines = 0
+    org_map: dict[str, dict] = {}
+    duplicates: set[str] = set()
+
+    for line in p.read_text(encoding="utf-8").splitlines():
