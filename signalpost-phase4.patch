+++ b/tests/test_phase4_operations.py
@@ -0,0 +1,168 @@
+import json
+import sys
+import threading
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))
+
+from norway_company_agent import telemetry  # noqa: E402
+
+
+def _read(path):
+    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]
+
+
+def test_company_context_isolation_across_pool_threads(tmp_path, monkeypatch):
+    log = tmp_path / "request-log.jsonl"
+    monkeypatch.setenv("SIGNALPOST_REQUEST_LOG", str(log))
+    orgs = [f"{900000000 + i}" for i in range(100)]
+
+    def worker(org):
+        # Context is entered INSIDE the worker: submit() does not copy context.
+        with telemetry.company_context(org):
+            for _ in range(3):
+                telemetry.record_request(module="registry_live", provider="BRREG", operation="GET", success=True, status=200)
+
+    with ThreadPoolExecutor(max_workers=12) as pool:
+        list(pool.map(worker, orgs))
+    events = _read(log)
+    assert len(events) == 300
+    assert all(event["organisation_number"] is not None for event in events)
+    counts = {}
+    for event in events:
+        counts[event["organisation_number"]] = counts.get(event["organisation_number"], 0) + 1
+    assert counts == {org: 3 for org in orgs}
+
+
+def test_context_reset_after_leaving(tmp_path, monkeypatch):
+    log = tmp_path / "request-log.jsonl"
+    monkeypatch.setenv("SIGNALPOST_REQUEST_LOG", str(log))
+    with ThreadPoolExecutor(max_workers=1) as pool:  # one reused thread
+        def inside():
+            with telemetry.company_context("810000001"):
+                telemetry.record_request(module="m", provider="BRREG", operation="GET", success=True, status=200)
+
+        def outside():
+            telemetry.record_request(module="m", provider="BRREG", operation="GET", success=True, status=200)
+
+        pool.submit(inside).result()
+        pool.submit(outside).result()
+    first, second = _read(log)
+    assert first["organisation_number"] == "810000001"
+    assert second["organisation_number"] is None
+
+
+def test_explicit_organisation_wins_over_context(tmp_path, monkeypatch):
+    log = tmp_path / "request-log.jsonl"
+    monkeypatch.setenv("SIGNALPOST_REQUEST_LOG", str(log))
+    with telemetry.company_context("810000001"):
+        telemetry.record_request(module="m", provider="BRREG", operation="GET", success=True, status=200, organisation_number="810000002")
+    assert _read(log)[0]["organisation_number"] == "810000002"
+
+
+def _line(org, provider, *, bytes_=0, cost=None, duration=10, status=200):
+    event = {"event_type": "request", "organisation_number": org, "module": "m", "provider": provider, "http_status": status, "success": status < 400, "duration_ms": duration, "bytes": bytes_}
+    if cost is not None:
+        event["cost_usd"] = cost
+    return json.dumps(event)
+
+
+def test_build_operations_by_org_exact(tmp_path):
+    log = tmp_path / "request-log.jsonl"
+    spans = tmp_path / "company-spans.jsonl"
+    log.write_text("\n".join([
+        _line("810000001", "BRREG", bytes_=100, duration=20),
+        _line("810000001", "website/http", bytes_=50, duration=30),
+        _line("810000002", "Tavily", bytes_=7, cost=0.008, duration=5),
+        _line("810000002", "Exa", cost=0.007),
+        "<<<<<<< HEAD",  # malformed
+        "",
+        _line(None, "BRREG", bytes_=11),
+        json.dumps({"event_type": "other"}),
+        _line("810000003", "BRREG", status=404),
+    ]) + "\n", encoding="utf-8")
+    spans.write_text(json.dumps({"organisation_number": "810000001", "stage": "registry", "elapsed_ms": 400}) + "\n" + json.dumps({"organisation_number": "810000001", "stage": "discovery", "elapsed_ms": 100}) + "\n", encoding="utf-8")
+    result, summary = telemetry.build_operations_by_org(log, spans)
+    assert list(result) == ["810000001", "810000002", "810000003"]
+    one = result["810000001"]
+    assert (one["requests"], one["bytes"], one["runtime_ms"], one["request_time_ms"], one["source"]) == (2, 150, 500, 50, "request-log")
+    assert one["by_connector"] == {"company_site": {"requests": 1, "bytes": 50, "cost_usd": 0.0}, "official_brreg": {"requests": 1, "bytes": 100, "cost_usd": 0.0}}
+    two = result["810000002"]
+    assert abs(two["third_party_cost_usd"] - 0.015) < 1e-12
+    assert two["runtime_ms"] == 0
+    assert set(two["by_connector"]) == {"tavily", "exa"}
+    assert summary["malformed"] == 1
+    assert summary["other_lines"] == 1
+    assert summary["lines_unattributed"] == 1
+    assert summary["unattributed"]["bytes"] == 11
+    assert summary["lines_total"] == 6 and summary["lines_attributed"] == 5
+
+
+def test_build_operations_is_deterministic(tmp_path):
+    log = tmp_path / "request-log.jsonl"
+    log.write_text("\n".join(_line(f"81000000{i % 3}", "BRREG", bytes_=i, cost=0.001 * i) for i in range(30)) + "\n", encoding="utf-8")
+    first = json.dumps(telemetry.build_operations_by_org(log)[0], sort_keys=True)
+    second = json.dumps(telemetry.build_operations_by_org(log)[0], sort_keys=True)
+    assert first == second
+
+
+def test_run_level_summary_matches_per_org_sum(tmp_path):
+    log = tmp_path / "request-log.jsonl"
+    lines = [_line(f"81000000{i % 4}", ["BRREG", "Tavily", "website/http"][i % 3], bytes_=i, cost=0.003 * (i % 2)) for i in range(40)]
+    log.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    events = [json.loads(line) for line in lines]
+    run = telemetry.summarize_requests(events)
+    per_org, _ = telemetry.build_operations_by_org(log)
+    assert run["requests"] == sum(item["requests"] for item in per_org.values())
+    assert abs(run["third_party_cost_usd"] - sum(item["third_party_cost_usd"] for item in per_org.values())) < 1e-9
+    for name, part in run["by_connector"].items():
+        assert part["requests"] == sum(item["by_connector"].get(name, {}).get("requests", 0) for item in per_org.values())
+
+
+def test_company_span_writes_only_when_configured(tmp_path, monkeypatch):
+    spans = tmp_path / "company-spans.jsonl"
+    with telemetry.company_span("810000001", "registry"):
+        pass
+    assert not spans.exists()
+    monkeypatch.setenv("SIGNALPOST_SPANS_LOG", str(spans))
+    with telemetry.company_span("810000001", "registry"):
+        pass
+    row = _read(spans)[0]
+    assert row["organisation_number"] == "810000001" and row["stage"] == "registry" and row["elapsed_ms"] >= 0
+
+
+def test_reconcile_operations_report():
+    report = {"source": "request-log", "log_lines_total": 5, "log_lines_unattributed": 0, "malformed_lines": 0, "envelope_requests_sum": 5, "cost_envelope_sum_usd": 0.01, "by_connector_envelope": {"exa": {"requests": 5, "bytes": 0, "cost_usd": 0.01}}}
+    metrics = {"requests": {"total_api_calls": 5, "third_party_cost_usd": 0.01, "by_connector": {"exa": {"requests": 5, "bytes": 0, "cost_usd": 0.01}}}}
+    assert telemetry.reconcile_operations_report(report, metrics)["reconciled"] is True
+    metrics["requests"]["total_api_calls"] = 6
+    assert telemetry.reconcile_operations_report(report, metrics)["reconciled"] is False
+
+
+def test_scrapy_middleware_logs_with_meta_org(tmp_path, monkeypatch):
+    import importlib.util
+    pytest = __import__("pytest")
+    pytest.importorskip("scrapy")
+    root = Path(__file__).resolve().parent.parent
+    spec = importlib.util.spec_from_file_location("scrapy_crawler_under_test", root / "archive" / "v2-crawler" / "scrapy_crawler.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    from scrapy.http import HtmlResponse, Request
+
+    log = tmp_path / "request-log.jsonl"
+    monkeypatch.setenv("SIGNALPOST_REQUEST_LOG", str(log))
+
+    class FakeCrawler:
+        pass
+
+    middleware = module.OperationalTelemetryMiddleware(FakeCrawler())
+    request = Request("https://example.no/", meta={"organisation_number": "810000001"})
+    middleware.process_request(request, None)
+    middleware.process_response(request, HtmlResponse("https://example.no/", body=b"<html>ok</html>", request=request), None)
+    robots = Request("https://example.no/robots.txt")  # no meta: mapped through the host
+    middleware.process_request(robots, None)
+    middleware.process_response(robots, HtmlResponse("https://example.no/robots.txt", body=b"", status=404, request=robots), None)
+    first, second = _read(log)
+    assert first["organisation_number"] == "810000001" and first["bytes"] == len(b"<html>ok</html>") and first["provider"] == "website/scrapy"
+    assert second["organisation_number"] == "810000001" and second["http_status"] == 404
diff --git a/tests/test_phase4_rate_limit.py b/tests/test_phase4_rate_limit.py
