new file mode 100644
index 0000000..4f9add3
--- /dev/null
+++ b/scripts/validate_operations.py
@@ -0,0 +1,156 @@
+#!/usr/bin/env python3
+"""Phase 4 acceptance checks for per-envelope operations and the rate limiter.
+
+    python scripts/validate_operations.py --run-dir out/latest-run --envelopes result/envelopes.jsonl
+
+Exit code 1 if any check fails. Pure Python, Windows-safe, no network.
+
+Checks 6 (no context leak) and 10 (429 behaviour) cannot be proven from a run's files: the request
+log records no URL, and 429 handling needs a fake server. They are covered by
+tests/test_phase4_operations.py and tests/test_phase4_rate_limit.py and reported as "covered_by_tests".
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import os
+import sys
+from datetime import datetime
+from pathlib import Path
+
+PROJECT_ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(PROJECT_ROOT / "src"))
+
+from norway_company_agent.output_contract import OPERATIONS_KEYS, OPERATIONS_SOURCES  # noqa: E402
+from norway_company_agent.telemetry import build_operations_by_org, summarize_requests  # noqa: E402
+
+
+def read_jsonl(path: Path) -> list[dict]:
+    rows = []
+    for line in path.read_text(encoding="utf-8").splitlines():
+        if line.strip():
+            rows.append(json.loads(line))
+    return rows
+
+
+def read_log_events(path: Path) -> list[dict]:
+    events = []
+    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
+        if not line.strip():
+            continue
+        try:
+            event = json.loads(line)
+        except ValueError:
+            continue
+        if isinstance(event, dict) and event.get("event_type") == "request":
+            events.append(event)
+    return events
+
+
+def _ts(value: str) -> float:
+    return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
+
+
+def run_checks(run_dir: Path, envelopes_path: Path, interval: float, allowed_unattributed: int) -> dict:
+    results: dict[str, dict] = {}
+
+    def record(name: str, passed: bool | None, detail: str) -> None:
+        results[name] = {"passed": passed, "detail": detail}
+
+    envelopes = read_jsonl(envelopes_path)
+    log_path = run_dir / "request-log.jsonl"
+    metrics_path = run_dir / "run-metrics.json"
+    if not log_path.exists():
+        record("request_log_present", False, f"{log_path} is missing")
+        return results
+    per_org, summary = build_operations_by_org(log_path, run_dir / "company-spans.jsonl")
+    events = read_log_events(log_path)
+    ops = [item.get("operations") or {} for item in envelopes]
+    env_requests = sum(int(o.get("requests") or 0) for o in ops)
+
+    record("1_request_totals", env_requests + summary["lines_unattributed"] == summary["lines_total"],
+           f"envelopes {env_requests} + unattributed {summary['lines_unattributed']} vs log {summary['lines_total']}")
+    record("2_zero_unattributed", summary["lines_unattributed"] <= allowed_unattributed,
+           f"{summary['lines_unattributed']} unattributed (allowed {allowed_unattributed}), malformed {summary['malformed']}")
+
+    metrics = json.loads(metrics_path.read_text(encoding="utf-8")) if metrics_path.exists() else None
+    if metrics is None:
+        for name in ("3_run_level_match", "4_cost_match", "5_connector_match"):
+            record(name, False, "run-metrics.json missing")
+    else:
+        req = metrics.get("requests") or {}
+        record("3_run_level_match", env_requests == int(req.get("total_api_calls") or 0), f"envelopes {env_requests} vs run-metrics {req.get('total_api_calls')}")
+        env_cost = math.fsum(float(o.get("third_party_cost_usd") or 0.0) for o in ops)
+        run_cost = float(req.get("third_party_cost_usd") or 0.0)
+        brreg_cost = sum(float(o.get("by_connector", {}).get("official_brreg", {}).get("cost_usd", 0.0)) for o in ops)
+        record("4_cost_match", abs(env_cost - run_cost) <= 1e-9 and brreg_cost == 0.0, f"envelopes {env_cost} vs run-metrics {run_cost}, brreg cost {brreg_cost}")
+        totals: dict[str, int] = {}
+        for o in ops:
+            for name, part in (o.get("by_connector") or {}).items():
+                totals[name] = totals.get(name, 0) + int(part.get("requests") or 0)
+        run_totals = {name: int(part.get("requests") or 0) for name, part in (req.get("by_connector") or {}).items()}
+        record("5_connector_match", totals == run_totals, f"envelopes {totals} vs run-metrics {run_totals}")
+
+    record("6_no_context_leak", None, "covered_by_tests (request log has no URL field)")
+
+    again, _ = build_operations_by_org(log_path, run_dir / "company-spans.jsonl")
+    mismatched = [
+        item.get("organisation_number") for item in envelopes
+        if json.dumps(item.get("operations"), sort_keys=True) != json.dumps(again.get(str(item.get("organisation_number"))) or item.get("operations"), sort_keys=True)
+    ]
+    record("7_determinism", not mismatched, f"{len(mismatched)} envelope(s) differ from a fresh aggregation")
+
+    bad_shape = []
+    for item in envelopes:
+        o = item.get("operations")
+        if not isinstance(o, dict) or tuple(o) != OPERATIONS_KEYS:
+            bad_shape.append(item.get("organisation_number")); continue
+        ints_ok = all(isinstance(o[k], int) and not isinstance(o[k], bool) for k in ("requests", "bytes", "runtime_ms", "request_time_ms"))
+        if not (ints_ok and isinstance(o["third_party_cost_usd"], (int, float)) and isinstance(o["by_connector"], dict) and o["source"] in OPERATIONS_SOURCES):
+            bad_shape.append(item.get("organisation_number"))
+    record("8_uniform_shape", not bad_shape, f"{len(bad_shape)} envelope(s) with wrong shape")
+
+    if interval > 0:
+        starts = sorted(_ts(e["timestamp"]) - (e.get("duration_ms") or 0) / 1000.0 for e in events if e.get("module") == "financial_history")
+        gaps = [b - a for a, b in zip(starts, starts[1:])]
+        worst = min(gaps) if gaps else None
+        record("9_limiter_spacing", worst is None or worst >= interval - 0.05, f"min gap between request starts {worst} (interval {interval})")
+    else:
+        record("9_limiter_spacing", None, "skipped: no interval configured")
+
+    record("10_429_behaviour", None, "covered_by_tests (fake server)")
+
+    last_index: dict[tuple, int] = {}
+    for index, e in enumerate(events):
+        last_index[(e.get("organisation_number"), e.get("module"))] = index
+    residual = [e.get("organisation_number") for index, e in enumerate(events) if e.get("http_status") == 429 and last_index[(e.get("organisation_number"), e.get("module"))] == index]
+    total_429 = sum(1 for e in events if e.get("http_status") == 429)
+    record("11_no_429_residue", not residual, f"{total_429} 429 line(s), {len(residual)} still failing after the final retry")
+    return results
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description="Phase 4 operations acceptance checks")
+    parser.add_argument("--run-dir", required=True)
+    parser.add_argument("--envelopes", required=True)
+    parser.add_argument("--interval", type=float, default=None, help="Configured brreg_history interval; default read from SIGNALPOST_RATE_LIMITS")
+    parser.add_argument("--allowed-unattributed", type=int, default=0)
+    args = parser.parse_args()
+    interval = args.interval
+    if interval is None:
+        try:
+            interval = float(json.loads(os.environ.get("SIGNALPOST_RATE_LIMITS") or "{}").get("brreg_history", 0.0))
+        except (ValueError, AttributeError, TypeError):
+            interval = 0.0
+    results = run_checks(Path(args.run_dir), Path(args.envelopes), interval, args.allowed_unattributed)
+    failed = [name for name, item in results.items() if item["passed"] is False]
+    for name, item in results.items():
+        mark = "PASS" if item["passed"] else "SKIP" if item["passed"] is None else "FAIL"
+        print(f"{mark:4} {name}: {item['detail']}")
+    print("RESULT:", "FAILED (" + ", ".join(failed) + ")" if failed else "PASSED")
+    return 1 if failed else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
