+"""Process-wide rate limiting for BRREG endpoints (Phase 4, P4.2).
+
+No internal imports. Each pipeline stage is its own process and stages run one after
+another, so one limiter instance is shared by the 12 stage-1 worker threads and that is
+sufficient. There is deliberately no cross-process locking.
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import sys
+import threading
+import time
+from datetime import datetime, timezone
+from email.utils import parsedate_to_datetime
+from typing import Any, Callable
+from urllib.parse import urlparse
+
+RETRY_AFTER_CAP_S = 120.0
+
+
+class RateLimiter:
+    """Thread-safe token bucket with burst 1: reserve the next free slot under a lock,
+    sleep outside the lock so waiting threads do not serialize each other's wake-ups."""
+
+    def __init__(self, min_interval_s: float, clock: Callable[[], float] = time.monotonic, sleep: Callable[[float], None] = time.sleep):
+        self._interval = float(min_interval_s)
+        self._clock = clock
+        self._sleep = sleep
+        self._lock = threading.Lock()
+        self._next = 0.0
+
+    @property
+    def min_interval_s(self) -> float:
+        return self._interval
+
+    def acquire(self) -> float:
+        if self._interval <= 0:
+            return 0.0
+        with self._lock:
+            now = self._clock()
+            slot = max(now, self._next)
+            self._next = slot + self._interval
+        wait = slot - now
+        if wait > 0:
+            self._sleep(wait)
+        return wait
+
+    def penalize(self, seconds: float) -> None:
+        """After a 429: push the next slot out so every thread backs off, not only the one throttled.
+        Works even when min_interval_s is 0, because a throttle must be honoured either way."""
+        with self._lock:
+            self._next = max(self._next, self._clock() + float(seconds))
+
+    def wait_for_penalty(self) -> float:
+        """Block until a penalty set by penalize() has expired. Used when no proactive interval is set."""
+        with self._lock:
+            now = self._clock()
+            wait = self._next - now
+        if wait > 0:
+            self._sleep(wait)
+            return wait
+        return 0.0
+
+
+# name, host, path_regex, min_interval_s.
+# Only an endpoint we can name by host AND path gets a rule. Company websites, Tavily and Exa
+# are different services with their own limits and are intentionally not limited here.
+#
+# brreg_history: the annual-account year list that official._fetch_history() documents as
+# "30 request starts per minute" (2.1 s). Baseline in the shipped sample run: 0 responses
+# with HTTP 429, so proactive spacing is OFF by default (0.0); 429 handling in http.fetch_json
+# is always on. Turn spacing on with SIGNALPOST_RATE_LIMITS='{"brreg_history": 2.1}'.
+DEFAULT_RULES: list[dict[str, Any]] = [
+    {
+        "name": "brreg_history",
+        "host": "data.brreg.no",
+        "path_regex": r"^/regnskapsregisteret/regnskap/aarsregnskap/kopi/\d{9}/aar/?$",
+        "min_interval_s": 0.0,
+    },
+]
+
+_LIMITERS: dict[tuple[str, float], RateLimiter] = {}
+_LIMITERS_LOCK = threading.Lock()
+_warned_invalid = False
+
+
+def _overrides() -> dict[str, float]:
+    global _warned_invalid
+    raw = os.environ.get("SIGNALPOST_RATE_LIMITS", "").strip()
+    if not raw:
+        return {}
+    try:
+        parsed = json.loads(raw)
+        if not isinstance(parsed, dict):
+            raise ValueError("not a JSON object")
+        return {str(key): float(value) for key, value in parsed.items()}
+    except (ValueError, TypeError):
+        if not _warned_invalid:
+            _warned_invalid = True
+            print("WARNING | SIGNALPOST_RATE_LIMITS is not a valid JSON object of {rule: seconds}; using defaults.", file=sys.stderr, flush=True)
+        return {}
+
+
+def limiter_for(url: str) -> RateLimiter | None:
+    """First matching rule wins. Returns the shared RateLimiter for that rule, or None."""
+    try:
+        parsed = urlparse(url)
+    except ValueError:
+        return None
+    host = (parsed.hostname or "").lower()
+    overrides = _overrides()
+    for rule in DEFAULT_RULES:
+        if host != rule["host"] or not re.search(rule["path_regex"], parsed.path or ""):
+            continue
+        interval = max(0.0, float(overrides.get(rule["name"], rule["min_interval_s"])))
+        key = (rule["name"], interval)
+        with _LIMITERS_LOCK:
+            limiter = _LIMITERS.get(key)
+            if limiter is None:
+                # A new interval for the same rule replaces the old instance, but a pending
+                # penalty must survive, so carry it over.
+                limiter = RateLimiter(interval)
+                for (name, _old), previous in list(_LIMITERS.items()):
+                    if name == rule["name"]:
+                        limiter._next = max(limiter._next, previous._next)
+                _LIMITERS[key] = limiter
+            return limiter
+    return None
+
+
+def reset_limiters() -> None:
+    """Test helper: forget all shared limiters and the one-shot warning."""
+    global _warned_invalid
+    with _LIMITERS_LOCK:
+        _LIMITERS.clear()
+    _warned_invalid = False
+
+
+def parse_retry_after(value: str | None, *, now: datetime | None = None) -> float | None:
+    """Retry-After as integer seconds or an HTTP-date. Capped at 120 s. None if absent/unparseable."""
+    if value is None:
+        return None
+    text = str(value).strip()
+    if not text:
+        return None
+    seconds: float | None = None
+    if re.fullmatch(r"\d+", text):
+        seconds = float(text)
+    else:
+        try:
+            moment = parsedate_to_datetime(text)
+        except (TypeError, ValueError):
+            return None
+        if moment.tzinfo is None:
+            moment = moment.replace(tzinfo=timezone.utc)
+        seconds = (moment - (now or datetime.now(timezone.utc))).total_seconds()
+    return min(RETRY_AFTER_CAP_S, max(0.0, seconds))
