+++ b/tests/test_phase4_rate_limit.py
@@ -0,0 +1,205 @@
+import io
+import json
+import sys
+import threading
+import urllib.error
+from email.message import Message
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))
+
+import pytest  # noqa: E402
+
+from norway_company_agent import http as http_module  # noqa: E402
+from norway_company_agent import rate_limit  # noqa: E402
+from norway_company_agent.rate_limit import RateLimiter  # noqa: E402
+
+HISTORY_URL = "https://data.brreg.no/regnskapsregisteret/regnskap/aarsregnskap/kopi/810034882/aar"
+
+
+class FakeClock:
+    def __init__(self):
+        self.now = 1000.0
+        self.sleeps = []
+        self.lock = threading.Lock()
+
+    def clock(self):
+        return self.now
+
+    def sleep(self, seconds):
+        with self.lock:
+            self.sleeps.append(seconds)
+
+
+def test_limiter_spaces_ten_threads_two_seconds_apart():
+    fake = FakeClock()
+    limiter = RateLimiter(2.0, clock=fake.clock, sleep=fake.sleep)
+    waits = []
+    lock = threading.Lock()
+
+    def call():
+        wait = limiter.acquire()
+        with lock:
+            waits.append(wait)
+
+    threads = [threading.Thread(target=call) for _ in range(10)]
+    [t.start() for t in threads]
+    [t.join() for t in threads]
+    assert sorted(waits) == [2.0 * i for i in range(10)]  # slots exactly 2.0 s apart
+
+
+def test_zero_interval_never_sleeps():
+    fake = FakeClock()
+    limiter = RateLimiter(0, clock=fake.clock, sleep=fake.sleep)
+    assert [limiter.acquire() for _ in range(5)] == [0.0] * 5
+    assert fake.sleeps == []
+
+
+def test_penalize_delays_all_callers_even_without_interval():
+    fake = FakeClock()
+    limiter = RateLimiter(0, clock=fake.clock, sleep=fake.sleep)
+    limiter.penalize(3.0)
+    assert limiter.wait_for_penalty() == 3.0
+    limiter2 = RateLimiter(2.0, clock=fake.clock, sleep=fake.sleep)
+    limiter2.penalize(10.0)
+    assert limiter2.acquire() == 10.0
+
+
+def test_limiter_for_matches_only_history_endpoint(monkeypatch):
+    rate_limit.reset_limiters()
+    monkeypatch.delenv("SIGNALPOST_RATE_LIMITS", raising=False)
+    assert rate_limit.limiter_for(HISTORY_URL) is not None
+    assert rate_limit.limiter_for(HISTORY_URL).min_interval_s == 0.0
+    assert rate_limit.limiter_for("https://data.brreg.no/enhetsregisteret/api/enheter/810034882") is None
+    assert rate_limit.limiter_for("https://data.brreg.no/regnskapsregisteret/regnskap/810034882") is None
+    assert rate_limit.limiter_for("https://example.no/regnskapsregisteret/regnskap/aarsregnskap/kopi/810034882/aar") is None
+    assert rate_limit.limiter_for(HISTORY_URL) is rate_limit.limiter_for(HISTORY_URL)  # shared instance
+
+
+def test_env_override_and_invalid_json(monkeypatch, capsys):
+    rate_limit.reset_limiters()
+    monkeypatch.setenv("SIGNALPOST_RATE_LIMITS", '{"brreg_history": 2.1}')
+    assert rate_limit.limiter_for(HISTORY_URL).min_interval_s == 2.1
+    rate_limit.reset_limiters()
+    monkeypatch.setenv("SIGNALPOST_RATE_LIMITS", "{not json")
+    assert rate_limit.limiter_for(HISTORY_URL).min_interval_s == 0.0
+    rate_limit.limiter_for(HISTORY_URL)
+    assert capsys.readouterr().err.count("SIGNALPOST_RATE_LIMITS") == 1  # one warning, no crash
+
+
+def test_parse_retry_after():
+    from datetime import datetime, timezone
+    assert rate_limit.parse_retry_after("3") == 3.0
+    assert rate_limit.parse_retry_after("9999") == 120.0
+    assert rate_limit.parse_retry_after(None) is None
+    assert rate_limit.parse_retry_after("garbage") is None
+    now = datetime(2026, 1, 1, 12, 0, 0, tzinfo=timezone.utc)
+    assert rate_limit.parse_retry_after("Thu, 01 Jan 2026 12:00:07 GMT", now=now) == 7.0
+    assert rate_limit.parse_retry_after("Thu, 01 Jan 2026 11:00:00 GMT", now=now) == 0.0
+
+
+class _Response:
+    status = 200
+
+    def __init__(self, body):
+        self._body = body
+
+    def read(self):
+        return self._body
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        return False
+
+
+def _http_429(retry_after):
+    headers = Message()
+    if retry_after is not None:
+        headers["Retry-After"] = retry_after
+    return urllib.error.HTTPError(HISTORY_URL, 429, "Too Many Requests", headers, io.BytesIO(b"slow down"))
+
+
+def _read_log(path):
+    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]
+
+
+def test_fetch_json_honours_retry_after_and_logs_each_attempt(tmp_path, monkeypatch):
+    rate_limit.reset_limiters()
+    log = tmp_path / "request-log.jsonl"
+    monkeypatch.setenv("SIGNALPOST_REQUEST_LOG", str(log))
+    monkeypatch.delenv("SIGNALPOST_RATE_LIMITS", raising=False)
+    calls = []
+
+    def fake_urlopen(request, timeout=None):
+        calls.append(request.full_url)
+        if len(calls) == 1:
+            raise _http_429("3")
+        return _Response(b'["2024","2025"]')
+
+    sleeps = []
+    monkeypatch.setattr(http_module.urllib.request, "urlopen", fake_urlopen)
+    monkeypatch.setattr(http_module.time, "sleep", lambda seconds: sleeps.append(seconds))
+    result = http_module.fetch_json(HISTORY_URL, module="financial_history", organisation_number="810034882")
+    assert result.status == 200 and result.body == ["2024", "2025"]
+    assert 3.0 in sleeps
+    events = _read_log(log)
+    assert [event["http_status"] for event in events] == [429, 200]
+    assert events[1]["attempt"] == 2 and events[1]["retry"] is True
+    assert events[0]["bytes"] == len(b"slow down") and events[1]["bytes"] == len(b'["2024","2025"]')
+
+
+def test_fetch_json_exhausted_429_is_marked_rate_limited(tmp_path, monkeypatch):
+    rate_limit.reset_limiters()
+    monkeypatch.setenv("SIGNALPOST_REQUEST_LOG", str(tmp_path / "request-log.jsonl"))
+
+    def always_429(request, timeout=None):
+        raise _http_429("1")
+
+    monkeypatch.setattr(http_module.urllib.request, "urlopen", always_429)
+    monkeypatch.setattr(http_module.time, "sleep", lambda seconds: None)
+    result = http_module.fetch_json(HISTORY_URL, module="financial_history", organisation_number="810034882")
+    assert result.status == 0 and "rate_limited" in result.error
+    from norway_company_agent.official import _classified
+    record = _classified("financial_history", "official_annual_account_copies", result)
+    assert record["status"] == "source_error" and "rate_limited" in record["note"]
+
+
+def test_fetch_json_404_still_not_found(tmp_path, monkeypatch):
+    rate_limit.reset_limiters()
+    monkeypatch.setenv("SIGNALPOST_REQUEST_LOG", str(tmp_path / "request-log.jsonl"))
+
+    def not_found(request, timeout=None):
+        raise urllib.error.HTTPError(HISTORY_URL, 404, "nf", Message(), io.BytesIO(b""))
+
+    monkeypatch.setattr(http_module.urllib.request, "urlopen", not_found)
+    result = http_module.fetch_json(HISTORY_URL, module="financial_history", organisation_number="810034882")
+    assert result.status == 404 and result.failure_class == "not_found"
+
+
+def test_fetch_json_acquires_limiter_per_attempt(tmp_path, monkeypatch):
+    rate_limit.reset_limiters()
+    monkeypatch.setenv("SIGNALPOST_REQUEST_LOG", str(tmp_path / "request-log.jsonl"))
+    monkeypatch.setenv("SIGNALPOST_RATE_LIMITS", '{"brreg_history": 2.1}')
+    acquired = []
+    original = RateLimiter.acquire
+
+    def counting(self):
+        acquired.append(1)
+        return 0.0
+
+    monkeypatch.setattr(RateLimiter, "acquire", counting)
+    attempts = []
+
+    def flaky(request, timeout=None):
+        attempts.append(1)
+        if len(attempts) < 3:
+            raise _http_429(None)
+        return _Response(b"[]")
+
+    monkeypatch.setattr(http_module.urllib.request, "urlopen", flaky)
+    monkeypatch.setattr(http_module.time, "sleep", lambda seconds: None)
+    monkeypatch.setattr(RateLimiter, "wait_for_penalty", lambda self: 0.0)
+    assert http_module.fetch_json(HISTORY_URL, organisation_number="810034882").status == 200
+    assert len(acquired) == 3  # once per attempt, not once per call
