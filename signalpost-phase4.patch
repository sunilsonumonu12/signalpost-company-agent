+    run_requests = int(requests.get("total_api_calls") or 0)
+    run_cost = float(requests.get("third_party_cost_usd") or 0.0)
+    run_connectors = requests.get("by_connector") or {}
+    envelope_connectors = report.get("by_connector_envelope") or {}
+
+    def same_connectors() -> bool:
+        if set(envelope_connectors) != set(run_connectors):
+            return False
+        return all(
+            int(envelope_connectors[name].get("requests", 0)) == int(run_connectors[name].get("requests", 0))
+            and int(envelope_connectors[name].get("bytes", 0)) == int(run_connectors[name].get("bytes", 0))
+            and abs(float(envelope_connectors[name].get("cost_usd", 0.0)) - float(run_connectors[name].get("cost_usd", 0.0))) <= 1e-9
+            for name in envelope_connectors
+        )
+
+    envelope_requests = int(report.get("envelope_requests_sum") or 0)
+    checks = {
+        "source_available": report.get("source") == "request-log",
+        "no_unattributed": int(report.get("log_lines_unattributed") or 0) == 0,
+        "no_malformed": int(report.get("malformed_lines") or 0) == 0,
+        "totals_add_up": envelope_requests + int(report.get("log_lines_unattributed") or 0) == int(report.get("log_lines_total") or 0),
+        "matches_run_metrics_requests": envelope_requests == run_requests,
+        "matches_run_metrics_cost": abs(float(report.get("cost_envelope_sum_usd") or 0.0) - run_cost) <= 1e-9,
+        "matches_run_metrics_connectors": same_connectors(),
+    }
+    report = dict(report)
+    report["run_metrics_requests"] = run_requests
+    report["cost_run_metrics_usd"] = run_cost
+    report["by_connector_run_metrics"] = run_connectors
+    report["reconcile_checks"] = checks
+    report["reconciled"] = all(checks.values())
+    return report
+
+
 def monotonic_ms(started: float) -> int:
     return int((time.monotonic() - started) * 1000)
